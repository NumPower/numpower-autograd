{
  "name": "numpower/autograd",
  "type": "library",
  "license": "MIT",
  "description": "High-performance math library with automatic differentiation and GPU support.",
  "homepage": "https://www.numpower.org",
  "authors": [
    {
      "name": "The NumPower Community",
      "email": "contact@numpower.org"
    },
    {
      "name": "Henrique Borba",
      "email": "henrique.borba.dev@gmail.com"
    }
  ],
  "scripts": {
    "phpstan": "vendor/bin/phpstan -c phpstan.neon"
  },
  "autoload": {
    "psr-4": {
      "NumPower\\": "src/",
      "NumPower\\Autograd\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "nunomaduro/phpinsights": "^2.11"
  },
  "require": {
    "php": ">=8.3",
    "ext-numpower": ">=0.5.2"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
